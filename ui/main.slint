import {
    AboutSlint,
    Button,
    ComboBox,
    HorizontalBox,
    LineEdit,
    Palette,
    ScrollView,
    StandardButton,
    StyleMetrics,
    VerticalBox,
} from "std-widgets.slint";

import { SettingsWindow } from "settings.slint";
import {
    Student,
    ViewMode,
} from "types.slint";

export {
    SettingsWindow,
    Student,
    ViewMode,
}

global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // surfaces
    out property <color> window-bg:   dark ? #1c1c1c : #f4f4f3;
    out property <color> menubar-bg:  dark ? #1f1f1f : #ececeb;
    out property <color> footer-bg:   dark ? #1c1c1c : #f4f4f3;
    out property <color> divider:     dark ? #2a2a2a : #dcdcda;

    // text
    out property <color> text-primary:   dark ? #e8e8e8 : #1e1e1e;
    out property <color> text-secondary: dark ? #7a7a7a : #6f6f6d;
    out property <color> menubar-text:   dark ? #cfcfcf : #3a3a38;
    out property <color> label:          dark ? #6a6a6a : #9a9a98;
    out property <color> time-value:     dark ? #d2d2d2 : #3a3a38;
    out property <color> summary-text:   dark ? #8a8a8a : #7a7a78;
    out property <color> placeholder:    dark ? #6a6a6a : #9a9a98;

    // cards
    out property <color> card-bg:        dark ? #242424 : #ffffff;
    out property <color> card-border:    dark ? #313131 : #e2e2e0;
    out property <color> card-bg-sel:    dark ? #1d2a22 : #eaf4ee;
    out property <color> accent:         #4a8f6b;
    out property <color> chrome:         dark ? #6b7a8c : #5a6b7d;
    out property <color> strip-neutral:  dark ? #333333 : #d8d8d6;
    out property <color> circle-border:  dark ? #4a4a4a : #c2c2c0;
    out property <color> hairline:       dark ? #3a3a3a : #dcdcda;

    // points
    out property <color> points-amber: dark ? #a8824a : #9a6f2e;
    out property <color> points-green: dark ? #6fb58c : #2f8a5b;

    // badges
    out property <color> badge-bg:   dark ? #5b8fb524 : #4f8fc022;
    out property <color> badge-dot:  dark ? #5f9bc4 : #4f8fc0;
    out property <color> badge-text: dark ? #8fbdde : #2f6f9e;

    // avatar
    out property <color> avatar-bg:       dark ? #303030 : #ececeb;
    out property <color> avatar-text:     dark ? #b0b0b0 : #5a5a58;
    out property <color> avatar-bg-sel:   dark ? #4a8f6b33 : #4a8f6b26;
    out property <color> avatar-text-sel: dark ? #8fd0ad : #2f8a5b;

    // inputs / buttons / popup
    out property <color> input-bg:       dark ? #2a2a2a : #ffffff;
    out property <color> input-border:   dark ? #3a3a3a : #cfcfcd;
    out property <color> popup-bg:       dark ? #232323 : #ffffff;
    out property <color> popup-hover:    dark ? #2e2e2e : #f0f0ee;
    out property <color> btn-bg:         dark ? #2d2d2d : #ffffff;
    out property <color> btn-border:     dark ? #3d3d3d : #cfcfcd;
    out property <color> btn-text:       dark ? #e0e0e0 : #2a2a28;
    out property <color> btn-pri-bg:     dark ? #23332b : #e6f3ec;
    out property <color> btn-pri-border: #4a8f6b;
    out property <color> btn-pri-text:   dark ? #bfe6cf : #2f7a52;
}

component SelectionCircle inherits Rectangle {
    in property <bool> selected;
    in property <length> size: 20px;

    width: size;
    height: size;
    border-radius: size / 2;
    background: selected ? Theme.accent : transparent;
    border-width: selected ? 0px : 1.5px;
    border-color: Theme.circle-border;

    Image {
        source: @image-url("icons/success-small-symbolic.svg");
        colorize: #ffffff;
        visible: root.selected;
    }
}

enum Alignment {
    center,
    top-left,
    top-center,
    top-right,
    center-left,
    center-right,
    bottom-left,
    bottom-center,
    bottom-right,
}

component StatusBadge {
    in property <Alignment> alignment: center;

    property <length> current-width: touch-area.has-hover ? 7.5rem : 0.5rem;
    property <length> current-height: touch-area.has-hover ? 1.8rem : 0.5rem;

    pure function fraction-x(alignment: Alignment) -> float {
        if (alignment == Alignment.top-left || alignment == Alignment.center-left || alignment == Alignment.bottom-left) {
            return 0;
        } else if (alignment == Alignment.top-right || alignment == Alignment.center-right || alignment == Alignment.bottom-right) {
            return 1;
        } else {
            return 0.5;
        }
    }

    pure function fraction-y(alignment: Alignment) -> float {
        if (alignment == Alignment.top-left || alignment == Alignment.top-center || alignment == Alignment.top-right) {
            return 0;
        } else if (alignment == Alignment.bottom-left || alignment == Alignment.bottom-center || alignment == Alignment.bottom-right) {
            return 1;
        } else {
            return 0.5;
        }
    }

    touch-area := TouchArea {
        width: root.current-width;
        height: root.current-height;
        x: (root.width - self.width) * fraction-x(alignment);
        y: (root.height - self.height) * fraction-y(alignment);
    }

    Rectangle {
        width: root.current-width;
        height: root.current-height;
        x: touch-area.x;
        y: touch-area.y;
        border-radius: self.height / 2;
        background: touch-area.has-hover ? Theme.badge-bg : Theme.badge-dot;
        clip: true;

        animate width, height, x, y, background {
            duration: 100ms;
            easing: ease-out;
        }

        Text {
            text: @tr("Manually added");
            font-size: 0.8rem;
            color: Theme.badge-text;
            opacity: touch-area.has-hover ? 1 : 0;

            animate opacity {
                duration: 100ms;
                easing: ease-in-out;
                delay: 50ms;
            }
        }
    }
}

component ComfyCard inherits Rectangle {
    in property <Student> student;
    callback clicked;

    height: 10rem;
    border-radius: 8px;
    border-width: 2px;
    border-color: student.selected ? Theme.accent : Theme.card-border;
    background: student.selected ? Theme.card-bg-sel : Theme.card-bg;

    TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    HorizontalBox {
        padding: 14px;
        spacing: 12px;

        SelectionCircle {
            selected: root.student.selected;
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.student.name;
                color: Theme.text-primary;
                font-size: 1.2rem;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: "@" + root.student.username;
                color: Theme.text-secondary;
                font-size: 0.95rem;
                font-family: "monospace";
                overflow: elide;
            }

            Rectangle { }

            HorizontalLayout {
                spacing: 30px;
                alignment: start;

                VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: @tr("TYPING TIME");
                        color: Theme.label;
                        font-size: 0.85rem;
                        letter-spacing: 0.07rem;
                    }

                    Text {
                        text: root.student.time-text;
                        color: Theme.time-value;
                        font-size: 1rem;
                        font-weight: 600;
                    }
                }

                VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: @tr("POINTS");
                        color: Theme.label;
                        font-size: 0.85rem;
                        letter-spacing: 0.07rem;
                    }

                    Text {
                        text: root.student.points-text;
                        color: root.student.selected ? Theme.points-green : Theme.points-amber;
                        font-size: 1rem;
                        font-weight: 600;
                    }
                }
            }
        }

        if root.student.manually-added: StatusBadge {
            alignment: top-right;
            horizontal-stretch: 0;
        }
    }
}

component CompactCard inherits Rectangle {
    in property <Student> student;
    callback clicked;

    height: 6rem;
    border-radius: 8px;
    border-width: 2px;
    border-color: student.selected ? Theme.accent : Theme.card-border;
    background: student.selected ? Theme.card-bg-sel : Theme.card-bg;

    TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    VerticalBox {
        spacing: 3px;

        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: self.width / 2;
                background: root.student.selected ? Theme.avatar-bg-sel : Theme.avatar-bg;

                Text {
                    text: root.student.initials;
                    color: root.student.selected ? Theme.avatar-text-sel : Theme.avatar-text;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 1px;
                horizontal-stretch: 1;

                Text {
                    text: root.student.name;
                    color: Theme.text-primary;
                    font-size: 1.1rem;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: "@" + root.student.username;
                    color: Theme.text-secondary;
                    font-size: 0.9rem;
                    font-family: "monospace";
                    overflow: elide;
                }
            }

            SelectionCircle {
                selected: root.student.selected;
                size: 18px;
            }
        }

        Rectangle { }

        HorizontalLayout {
            spacing: 4px;
            cross-axis-alignment: center;

            if root.student.manually-added: StatusBadge {
                alignment: center-left;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: root.student.time-text + " ·";
                color: Theme.text-secondary;
                font-size: 0.95rem;
            }

            Text {
                text: root.student.points-text;
                color: root.student.selected ? Theme.points-green : Theme.points-amber;
                font-size: 0.95rem;
                font-weight: 600;
            }
        }
    }
}

component AccentStripCard inherits Rectangle {
    in property <Student> student;
    callback clicked;

    height: 9rem;
    border-radius: 6px;
    border-width: 2px;
    border-color: student.selected ? Theme.accent : Theme.card-border;
    background: student.selected ? Theme.card-bg-sel : Theme.card-bg;
    clip: true;

    TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        Rectangle {
            width: 5px;
            background: root.student.selected ? Theme.accent : Theme.strip-neutral;
        }

        VerticalBox {
            spacing: 0px;

            HorizontalBox {
                VerticalLayout {
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 0.5rem;

                        Text {
                            text: root.student.name;
                            color: Theme.text-primary;
                            font-size: 1.2rem;
                            font-weight: 600;
                            overflow: elide;
                        }

                        if root.student.manually-added: StatusBadge {
                            alignment: center-left;
                        }
                    }

                    Text {
                        text: "@" + root.student.username;
                        color: Theme.text-secondary;
                        font-size: 1rem;
                        font-family: "monospace";
                        overflow: elide;
                    }
                }

                SelectionCircle {
                    selected: root.student.selected;
                }
            }

            Rectangle { }

            HorizontalBox {
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Text {
                        text: @tr("TIME");
                        color: Theme.label;
                        font-size: 0.9rem;
                        letter-spacing: 0.07rem;
                    }

                    Text {
                        text: root.student.time-text;
                        color: Theme.time-value;
                        font-size: 1rem;
                    }
                }

                Rectangle {
                    width: 1.75px;
                    height: 1.3rem;
                    background: Theme.hairline;
                }

                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Text {
                        text: @tr("POINTS");
                        color: Theme.label;
                        font-size: 0.9rem;
                        letter-spacing: 0.07rem;
                    }

                    Text {
                        text: root.student.points-text;
                        color: root.student.selected ? Theme.points-green : Theme.points-amber;
                        font-size: 1rem;
                        font-weight: 600;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    preferred-width: 1000px;
    preferred-height: 800px;
    title: "Keystroke";
    forward-focus: search;

    in property <ViewMode> view-mode: comfortable;
    in-out property <[Student]> students: [];
    in property <int> selection-count: 0;

    callback check-for-updates;
    callback open-settings;
    callback quit;

    callback search-edited(string);
    callback search-accepted(string);
    callback toggle(int);
    callback refresh;
    callback give-points;

    MenuBar {
        Menu {
            title: "Keystroke";

            MenuItem {
                title: @tr("About");
                activated => about-popup.show();
            }

            MenuItem {
                title: @tr("Check for Updates");
                activated => root.check-for-updates();
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Open Settings");
                shortcut: @keys(Control + Comma);
                activated => root.open-settings();
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Quit");
                shortcut: @keys(Control + Q);
                activated => root.quit();
            }
        }

        Menu {
            title: @tr("Action");

            MenuItem {
                title: @tr("Refresh");
                shortcut: @keys(Control + R);
                activated => root.refresh();
            }

            MenuItem {
                title: @tr("Give points");
                activated => root.give-points();
            }
        }

        Menu {
            title: @tr("Help");

            MenuItem {
                title: @tr("File a Bug Report...");
                activated => Platform.open-url("https://github.com/megabyte6/keystroke/issues");
            }
        }
    }

    VerticalLayout {
        VerticalBox {
            HorizontalBox {
                search := LineEdit {
                    placeholder-text: @tr("Search");
                }

                filter := ComboBox {
                    model: [@tr("All students"), @tr("In current class"), @tr("Only selected")];
                    horizontal-stretch: 0;
                }
            }

            if root.view-mode == ViewMode.comfortable: svComfy := ScrollView {
                viewport-width: self.visible-width;
                viewport-height: StyleMetrics.layout-padding * 2 + Math.ceil(root.students.length / self.cols) * (dummyComfyCard.height + self.gap) - self.gap;
                vertical-stretch: 1;

                property <length> gap: StyleMetrics.layout-spacing * 1.5;
                property <length> min-card-width: 300px;
                property <length> available: self.visible-width - StyleMetrics.layout-padding * 2;

                property <int> cols: Math.max(1, Math.floor((self.available + self.gap) / (self.min-card-width + self.gap)));
                property <length> card-width: (self.available - self.gap * (self.cols - 1)) / self.cols;

                // must use a dummy card and manual viewport-height until
                // https://github.com/slint-ui/slint/issues/10185 gets a fix
                dummyComfyCard := ComfyCard {
                    visible: false;
                }

                for s[i] in root.students: ComfyCard {
                    width: svComfy.card-width;
                    x: StyleMetrics.layout-padding + Math.mod(i, svComfy.cols) * (svComfy.card-width + svComfy.gap);
                    y: StyleMetrics.layout-padding + Math.floor(i / svComfy.cols) * (self.height + svComfy.gap);
                    student: s;
                    clicked => {
                        root.students[i].selected = !root.students[i].selected;
                        root.toggle(i);
                    }
                }
            }
            if root.view-mode == ViewMode.compact: svCompact := ScrollView {
                viewport-width: self.visible-width;
                viewport-height: StyleMetrics.layout-padding * 2 + Math.ceil(root.students.length / self.cols) * (dummyCompactCard.height + self.gap) - self.gap;
                vertical-stretch: 1;

                property <length> gap: StyleMetrics.layout-spacing;
                property <length> min-card-width: 220px;
                property <length> available: self.visible-width - StyleMetrics.layout-padding * 2;

                property <int> cols: Math.max(1, Math.floor((self.available + self.gap) / (self.min-card-width + self.gap)));
                property <length> card-width: (self.available - self.gap * (self.cols - 1)) / self.cols;

                // must use a dummy card and manual viewport-height until
                // https://github.com/slint-ui/slint/issues/10185 gets a fix
                dummyCompactCard := CompactCard {
                    visible: false;
                }

                for s[i] in root.students: CompactCard {
                    width: svCompact.card-width;
                    x: StyleMetrics.layout-padding + Math.mod(i, svCompact.cols) * (svCompact.card-width + svCompact.gap);
                    y: StyleMetrics.layout-padding + Math.floor(i / svCompact.cols) * (self.height + svCompact.gap);
                    student: s;
                    clicked => {
                        root.students[i].selected = !root.students[i].selected;
                        root.toggle(i);
                    }
                }
            }
            if root.view-mode == ViewMode.accent-strip: svAccentStrip := ScrollView {
                viewport-width: self.visible-width;
                viewport-height: StyleMetrics.layout-padding * 2 + Math.ceil(root.students.length / self.cols) * (dummyAccentStripCard.height + self.gap) - self.gap;
                vertical-stretch: 1;

                property <length> gap: StyleMetrics.layout-spacing * 1.5;
                property <length> min-card-width: 375px;
                property <length> available: self.visible-width - StyleMetrics.layout-padding * 2;

                property <int> cols: Math.max(1, Math.floor((self.available + self.gap) / (self.min-card-width + self.gap)));
                property <length> card-width: (self.available - self.gap * (self.cols - 1)) / self.cols;

                // must use a dummy card and manual viewport-height until
                // https://github.com/slint-ui/slint/issues/10185 gets a fix
                dummyAccentStripCard := AccentStripCard {
                    visible: false;
                }

                for s[i] in root.students: AccentStripCard {
                    width: svAccentStrip.card-width;
                    x: StyleMetrics.layout-padding + Math.mod(i, svAccentStrip.cols) * (svAccentStrip.card-width + svAccentStrip.gap);
                    y: StyleMetrics.layout-padding + Math.floor(i / svAccentStrip.cols) * (self.height + svAccentStrip.gap);
                    student: s;
                    clicked => {
                        root.students[i].selected = !root.students[i].selected;
                        root.toggle(i);
                    }
                }
            }
        }

        Rectangle {
            width: 100%;
            height: 1.5px;
            background: Theme.divider;
        }

        HorizontalBox {
            padding: StyleMetrics.layout-padding * 2;
            alignment: space-between;
            cross-axis-alignment: center;

            Button {
                text: @tr("Refresh");
                preferred-width: 10rem;
                clicked => root.refresh();
            }

            Text {
                text: root.selection-count + @tr(" selected");
                color: Theme.summary-text;
                font-size: 0.9rem;
            }

            Button {
                text: @tr("Give points");
                preferred-width: 10rem;
                primary: true;
                clicked => root.give-points();
            }
        }
    }

    about-popup := PopupWindow {
        width: root.width * 0.5;
        height: root.height * 0.5;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.alternate-background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;

            VerticalBox {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Keystroke";
                    font-size: 28px;
                    font-weight: 700;
                    color: Palette.alternate-foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("A simple cross-platform graphical tool that rewards consistent typing with points.");
                    font-size: 13px;
                    color: Palette.alternate-foreground;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 2px;
                    background: Palette.border;
                }

                HorizontalBox {
                    VerticalBox {
                        spacing: 4px;

                        Text {
                            text: @tr("Author") + ": Brayden Chan";
                            font-size: 12px;
                            color: Palette.alternate-foreground;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: @tr("License") + ": GPL-3.0";
                            font-size: 12px;
                            color: Palette.alternate-foreground;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            clicked => Platform.open-url("https://github.com/megabyte6/keystroke");

                            Text {
                                text: "github.com/megabyte6/keystroke";
                                font-size: 12px;
                                color: #89b4fa;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: self.min-width;
                        border-width: 2px;
                        border-color: Palette.border;

                        AboutSlint { }
                    }
                }

                HorizontalBox {
                    alignment: center;

                    StandardButton {
                        kind: close;
                        clicked => about-popup.close();
                    }
                }
            }
        }
    }
}
