import {
    LineEdit,
    VerticalBox,
    HorizontalBox,
    ScrollView,
    Button,
    AboutSlint,
    Palette,
    StandardButton,
} from "std-widgets.slint";
import { SettingsWindow } from "settings.slint";

export { SettingsWindow }

export component MainWindow inherits Window {
    preferred-width: 1000px;
    preferred-height: 800px;
    title: "Keystroke";
    forward-focus: search;

    callback check-for-updates;
    callback open-settings;
    callback quit;

    callback refresh;
    callback give-points;

    MenuBar {
        Menu {
            title: "Keystroke";

            MenuItem {
                title: @tr("About");
                activated => about-popup.show();
            }

            MenuItem {
                title: @tr("Check for Updates");
                activated => root.check-for-updates();
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Open Settings");
                shortcut: @keys(Control + Comma);
                activated => root.open-settings();
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Quit");
                shortcut: @keys(Control + Q);
                activated => root.quit();
            }
        }

        Menu {
            title: @tr("Action");

            MenuItem {
                title: @tr("Refresh");
                shortcut: @keys(Control + R);
                activated => root.refresh();
            }

            MenuItem {
                title: @tr("Give points");
                activated => root.give-points();
            }
        }

        Menu {
            title: @tr("Help");

            MenuItem {
                title: @tr("File a Bug Report...");
                activated => Platform.open-url("https://github.com/megabyte6/keystroke/issues");
            }
        }
    }

    VerticalBox {
        search := LineEdit {
            placeholder-text: @tr("Search");
        }

        ScrollView {
            students := VerticalBox { }
        }

        HorizontalBox {
            height: 4rem;

            Button {
                text: "Refresh";
                preferred-width: 12rem;
                clicked => root.refresh();
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Give points";
                preferred-width: 12rem;
                clicked => root.give-points();
            }
        }
    }

    about-popup := PopupWindow {
        width: root.width * 0.5;
        height: root.height * 0.5;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.alternate-background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;

            VerticalBox {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Keystroke";
                    font-size: 28px;
                    font-weight: 700;
                    color: Palette.alternate-foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("A simple cross-platform graphical tool that rewards consistent typing with points.");
                    font-size: 13px;
                    color: Palette.alternate-foreground;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 2px;
                    background: Palette.border;
                }

                HorizontalBox {
                    VerticalBox {
                        spacing: 4px;

                        Text {
                            text: @tr("Author") + ": Brayden Chan";
                            font-size: 12px;
                            color: Palette.alternate-foreground;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: @tr("License") + ": GPL-3.0";
                            font-size: 12px;
                            color: Palette.alternate-foreground;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            clicked => Platform.open-url("https://github.com/megabyte6/keystroke");

                            Text {
                                text: "github.com/megabyte6/keystroke";
                                font-size: 12px;
                                color: #89b4fa;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: self.min-width;
                        border-width: 2px;
                        border-color: Palette.border;

                        AboutSlint { }
                    }
                }

                HorizontalBox {
                    alignment: center;

                    StandardButton {
                        kind: close;
                        clicked => about-popup.close();
                    }
                }
            }
        }
    }
}
