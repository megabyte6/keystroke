@rust-attr(derive(Eq, serde::Serialize, serde::Deserialize))
export enum ViewMode {
    comfortable,
    compact,
    accent-strip,
}

export struct Student {
    name: string,
    username: string,
    initials: string,
    time-text: string,
    points-text: string,
    manually-added: bool,
    selected: bool,
}
